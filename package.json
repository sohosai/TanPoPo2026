{
  "name": "tanpopo2026",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:reset": "bun run --cwd apps/api db:reset",
    "check": "turbo run check-types",
    "check:map-data": "bun run scripts/validate-map-data.ts",
    "ingest:osm": "bun run scripts/ingest-osm.ts",
    "merge:osm": "bun run scripts/merge-osm.ts",
    "clean": "turbo run clean && rm -rf .turbo",
    "format": "biome format . --write && prettier --write \"**/*.html\"",
    "ci": "bun run format:check && bun run check && bun run check:map-data",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "deploy": "bun run build && bun run --cwd apps/api deploy",
    "format:check": "biome format . && prettier --check \"**/*.html\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "prettier": "^3.8.2",
    "turbo": "^2.9.5",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
