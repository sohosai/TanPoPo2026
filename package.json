{
  "name": "tanpopo2026",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check-types",
    "check:map-data": "bun run scripts/validate-map-data.ts",
    "ingest:osm": "bun run scripts/ingest-osm.ts",
    "merge:osm": "bun run scripts/merge-osm.ts",
    "clean": "turbo run clean && rm -rf .turbo",
    "format": "biome format . --write && prettier --write \"**/*.html\"",
    "ci": "bun run check && bun run format",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "lefthook": "^2.1.5",
    "prettier": "^3.8.2",
    "turbo": "^2.9.5",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/geo-layers": "^9.3.6",
    "@deck.gl/mapbox": "^9.3.6",
    "@loaders.gl/3d-tiles": "^4.4.3"
  }
}
