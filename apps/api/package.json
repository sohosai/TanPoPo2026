{
  "name": "api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "mkdir -p ../web/build/client && wrangler dev --port 8787",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply DB --local",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.148.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.16.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.12.12",
    "jose": "^6.2.12",
    "zod": "^4.3.6"
  }
}
