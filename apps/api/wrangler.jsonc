{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanpopo",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/build/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/trpc/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanpopo",
      // `wrangler d1 create tanpopo` で発行された ID に置き換える。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  // 本番用の値。ローカルでは .dev.vars の値で上書きされる。
  // LINE_CHANNEL_SECRET は `wrangler secret put LINE_CHANNEL_SECRET` で登録する。
  "vars": {
    "SOS_API_URL": "https://sos26-api.sohosai.com",
    "GRANDPRIX_WIN_RATE": "0.2",
    "LINE_CHANNEL_ID": "",
    "LINE_CALLBACK_URL": ""
  }
}
