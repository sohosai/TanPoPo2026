{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanpopo",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/build/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/trpc/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanpopo",
      "database_id": "413cbc29-ab32-45c3-a273-30108bc25bbc",
      "migrations_dir": "db/migrations"
    }
  ]
}
