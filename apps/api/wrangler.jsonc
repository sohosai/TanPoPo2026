{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanpopo",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/build/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/trpc/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanpopo",
      "database_id": "413cbc29-ab32-45c3-a273-30108bc25bbc",
      "migrations_dir": "db/migrations"
    }
  ],
  "env": {
    "zoo": {
      "name": "tanpopo-zoo",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanpopo-zoo",
          "database_id": "ab11af29-d638-4960-8fef-9768f0bdbcbe",
          "migrations_dir": "db/migrations"
        }
      ]
    },
    "prod": {
      "name": "tanpopo-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tanpopo-prod",
          "database_id": "241b6162-7b2b-4421-a596-55e08d967436",
          "migrations_dir": "db/migrations"
        }
      ]
    }
  }
}
