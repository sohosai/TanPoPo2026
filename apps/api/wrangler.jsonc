{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanpopo",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/build/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/trpc/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanpopo",
      "database_id": "413cbc29-ab32-45c3-a273-30108bc25bbc",
      "migrations_dir": "db/migrations"
    }
  ],
  "vars": {
    "SOS_API_URL": "https://sos26-api.sohosai.com",
    "GRANDPRIX_WIN_RATE": "0.2",
    "HIDDEN_PROJECT_NUMBERS": "",
    "GRANDPRIX_HIDDEN_PROJECT_NUMBERS": "",
    "LINE_CHANNEL_ID": "2011922916",
    "LINE_CALLBACK_URL": "http://localhost:5173/auth/line/callback"
  }
}
